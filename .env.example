# Cluster
KUBECONFIG_PATH=./k3s.yaml
K8S_API_SERVER=https://192.168.20.240:6443
K8S_VERIFY_SSL=true

# Convenciones de despliegue
DEFAULT_NAMESPACE=user-apps
INGRESS_BASE_DOMAIN=andreslobaton.top
INGRESS_CLASS=traefik
CERT_MANAGER_CLUSTER_ISSUER=letsencrypt-prod
# URL publica del webhook entrante de GitHub (Settings -> Webhooks de la org).
GITHUB_WEBHOOK_URL=https://laurel.andreslobaton.top/api/webhooks/github
GITHUB_WEBHOOK_SECRET=
CONTAINER_PORT=80
SERVICE_TYPE=LoadBalancer
SERVICE_PORT_RANGE_START=3020
SERVICE_PORT_RANGE_END=3999
HPA_TARGET_CPU=80

# Override DNS interno del cluster (cert-manager HTTP-01 self-check)
DNS_OVERRIDE_CM_NAME=coredns-custom
DNS_OVERRIDE_CM_NAMESPACE=kube-system
DNS_OVERRIDE_FILE=andreslobaton.server
DNS_OVERRIDE_LAN_IP=192.168.20.240
DNS_OVERRIDE_ZONE=andreslobaton.top

# --- Integraciones externas: Jenkins ---
# URL publica de Jenkins. Por default https://jenkings.andreslobaton.top
# (ojo con la grafia: "jenkings", no "jenkins"). El build token se guarda
# en el system secret `jenkins_token` (ver /api/system/secrets/jenkins_token).
JENKINS_URL=https://jenkins.andreslobaton.top

# Base de datos: sqlite (dev) | mysql (prod)
DB_TYPE=sqlite
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=laurel

# --- Auth Google ---
# Reemplaza con el OAuth Client ID de Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:5173, http://<IP-del-frontend>
GOOGLE_CLIENT_ID=

# TTL del JWT firmado por el backend (stateless, no hay refresh).
JWT_TTL_HOURS=24

# Secret para firmar el JWT. En dev se deja vacio (usa el default).
# En prod: >= 32 chars alfanumericos, fuera del control de versiones.
SECRET_KEY=dev-secret-key-change-in-prod

# Origins del front permitidos por CORS (separados por coma).
# Defaults: localhost y la IP LAN tipica; agrega otras si hace falta.
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.20.240:5173

# --- Integraciones externas: GitHub + GitHub Container Registry (modo legacy, desde .env) ---
# PATs para crear los repos de cada Application al crearla. Si estan vacios
# el backend intenta los system secrets del cluster (github_pat).
# El mismo PAT de GitHub se usa para push a GHCR (scope write:packages).
GITHUB_ORG=laurel-applications
GITHUB_PAT=
GHCR_OWNER=laurel-applications
